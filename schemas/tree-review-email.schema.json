{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tree-review-email.schema.json",
  "title": "Stage 2 Part B: Daniel's first-review email (spec §10.2)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "email"
  ],
  "properties": {
    "email": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject",
        "opener",
        "whatWorks",
        "questions",
        "pointers",
        "ps"
      ],
      "properties": {
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "opener": {
          "type": "string",
          "minLength": 1
        },
        "whatWorks": {
          "type": "string",
          "minLength": 1
        },
        "questions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "question",
              "followUp"
            ],
            "properties": {
              "question": {
                "type": "string",
                "minLength": 1
              },
              "followUp": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "pointers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "ps": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
